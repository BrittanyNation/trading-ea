//@version=6
// ============================================================================
//  Supply & Demand Zones — one strategy, no clutter
// ----------------------------------------------------------------------------
//  Detects fresh institutional-style zones and draws them as boxes:
//    SUPPLY (red):   strong rally, small base, strong drop away
//    DEMAND (green): strong drop,  small base, strong rally away
//  Zones extend right. A zone turns gray once price closes through it
//  (mitigated). An alert fires the first time price enters a fresh zone.
//  Built for XAUUSD on 4H and 15m. This draws zones, it does not pick
//  trades: wait for price to reach a zone, then trade your confirmation.
// ============================================================================
indicator("Supply Demand Zones", shorttitle="SD Zones",
     overlay=true, max_boxes_count=200)

// ===================== INPUTS =====================
baseLen  = input.int(3, "Base candles", minval=1, maxval=6)
bodyPct  = input.float(30.0, "Base max body (% of ATR)", minval=5.0, maxval=100.0, step=5.0)
legMult  = input.float(2.0, "Prior leg min move (x ATR)", minval=0.5, maxval=10.0, step=0.5)
brkMult  = input.float(0.8, "Breakout min body (x ATR)", minval=0.3, maxval=5.0, step=0.1)
legLen   = input.int(10, "Prior leg lookback bars", minval=3, maxval=50)
maxZones = input.int(8, "Max zones kept", minval=1, maxval=20)
atrLen   = input.int(14, "ATR length", minval=1)
supColor = input.color(color.red, "Supply zone color")
demColor = input.color(color.green, "Demand zone color")

// ===================== CORE =====================
atr = ta.atr(atrLen)

// Hoisted so ta.* runs on every bar (no inconsistent-call warnings).
legTopRaw  = ta.highest(high, legLen)
legBotRaw  = ta.lowest(low, legLen)
baseTopRaw = ta.highest(high, baseLen)
baseBotRaw = ta.lowest(low, baseLen)

var array<box>   supZBox = array.new_box()
var array<float> supZTop = array.new_float()
var array<float> supZBot = array.new_float()
var array<bool>  supZMit = array.new_bool()
var array<bool>  supZAlr = array.new_bool()
var array<int>   supZBar = array.new_int()

var array<box>   demZBox = array.new_box()
var array<float> demZTop = array.new_float()
var array<float> demZBot = array.new_float()
var array<bool>  demZMit = array.new_bool()
var array<bool>  demZAlr = array.new_bool()
var array<int>   demZBar = array.new_int()

trimZones() =>
    while array.size(supZBox) > maxZones
        box.delete(array.shift(supZBox))
        array.shift(supZTop)
        array.shift(supZBot)
        array.shift(supZMit)
        array.shift(supZAlr)
        array.shift(supZBar)
    while array.size(demZBox) > maxZones
        box.delete(array.shift(demZBox))
        array.shift(demZTop)
        array.shift(demZBot)
        array.shift(demZMit)
        array.shift(demZAlr)
        array.shift(demZBar)

// Zone detection runs on confirmed bars only, so zones never repaint intrabar.
if barstate.isconfirmed
    bodyMax = bodyPct / 100 * atr
    isBase = true
    for i = 1 to baseLen
        if math.abs(close[i] - open[i]) >= bodyMax
            isBase := false
            break
    if isBase
        legTop = legTopRaw[baseLen + 1]
        legBot = legBotRaw[baseLen + 1]
        if not na(legTop) and not na(legBot)
            legMove  = legTop - legBot
            legOpen  = open[baseLen + legLen]
            legClose = close[baseLen + 1]
            baseTop  = baseTopRaw[1]
            baseBot  = baseBotRaw[1]
            curBody  = math.abs(close - open)
            // SUPPLY: rally, base, drop
            if legMove >= legMult * atr and legClose > legOpen and close < open and curBody >= brkMult * atr and close < baseBot
                zb = box.new(bar_index - baseLen, baseTop, bar_index, baseBot,
                     bgcolor=color.new(supColor, 80), border_color=supColor)
                array.push(supZBox, zb)
                array.push(supZTop, baseTop)
                array.push(supZBot, baseBot)
                array.push(supZMit, false)
                array.push(supZAlr, false)
                array.push(supZBar, bar_index)
            // DEMAND: drop, base, rally
            if legMove >= legMult * atr and legClose < legOpen and close > open and curBody >= brkMult * atr and close > baseTop
                zb = box.new(bar_index - baseLen, baseTop, bar_index, baseBot,
                     bgcolor=color.new(demColor, 80), border_color=demColor)
                array.push(demZBox, zb)
                array.push(demZTop, baseTop)
                array.push(demZBot, baseBot)
                array.push(demZMit, false)
                array.push(demZAlr, false)
                array.push(demZBar, bar_index)
            trimZones()

// Zone maintenance: extend to the right, gray out mitigated zones,
// alert on first entry into a fresh zone.
if array.size(supZBox) > 0
    for i = 0 to array.size(supZBox) - 1
        b = array.get(supZBox, i)
        box.set_right(b, bar_index)
        if not array.get(supZMit, i)
            top = array.get(supZTop, i)
            bot = array.get(supZBot, i)
            if close > top
                array.set(supZMit, i, true)
                box.set_bgcolor(b, color.new(color.gray, 85))
                box.set_border_color(b, color.gray)
            else if bar_index > array.get(supZBar, i) and not array.get(supZAlr, i) and low <= top and high >= bot
                array.set(supZAlr, i, true)
                alert("Price entering SUPPLY zone", alert.freq_once_per_bar)

if array.size(demZBox) > 0
    for i = 0 to array.size(demZBox) - 1
        b = array.get(demZBox, i)
        box.set_right(b, bar_index)
        if not array.get(demZMit, i)
            top = array.get(demZTop, i)
            bot = array.get(demZBot, i)
            if close < bot
                array.set(demZMit, i, true)
                box.set_bgcolor(b, color.new(color.gray, 85))
                box.set_border_color(b, color.gray)
            else if bar_index > array.get(demZBar, i) and not array.get(demZAlr, i) and low <= top and high >= bot
                array.set(demZAlr, i, true)
                alert("Price entering DEMAND zone", alert.freq_once_per_bar)
